PORT=8787
CORS_ORIGIN=*
# Express trust proxy. Blank = 1 hop on Railway (the edge proxy), off elsewhere.
TRUST_PROXY=
# Enforced rate limits, "<requests>/<window seconds>", or "off" for one limit.
# RATE_LIMITS=off switches all of them off. Defaults shown.
RATE_LIMITS=on
RATE_AUTHORIZE_IP=60/600
RATE_AUTHORIZE_GLOBAL=600/60
RATE_UPLOAD_IP=60/600
RATE_UPLOAD_GLOBAL=300/60
RATE_PROFILE_IP=20/3600
RATE_PROFILE_GLOBAL=60/600
RATE_ADMIN_LOGIN_IP=10/900
RATE_ADMIN_LOGIN_GLOBAL=50/900
DATABASE_URL=
# Optional Postgres pool limits in ms (defaults 5000 and 10000).
PG_CONNECT_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=10000
SQLITE_PATH=./data/leaderboard.sqlite
ALLOWED_PUBLIC_KEYS=
ADMIN_TOKEN=change-this-to-a-long-random-secret
# Session login for the admin panel (used by the embedded hub).
ADMIN_PASSWORD=change-this-to-a-strong-password
SESSION_SECRET=change-this-to-a-long-random-secret
SESSION_TTL_SECONDS=43200
# "off" switches off the password login at /admin/login, so the hub's /sso is
# the only way in for a person. Default on. ADMIN_TOKEN header auth is unaffected.
DIRECT_ADMIN_LOGIN=on
# Hub single sign-on (short-lived HS256 JWT, aud "leaderboard").
LEADERBOARD_SSO_SECRET=change-this-to-a-long-random-secret
LEADERBOARD_SSO_AUDIENCE=leaderboard
# Origin allowed to embed the admin panel in an iframe.
HUB_ORIGIN=https://admin-panel-production-39e5.up.railway.app
# Optional. Key used to mask other players' GUIDs in GET /get. If blank, a key
# derived from SESSION_SECRET is used, else a random per-process value.
GUID_MASK_SECRET=
MAX_USERNAME_LENGTH=127
MAX_EXTRA_LENGTH=100
# Highest score a game upload may store (default and ceiling: 2147483647).
MAX_SCORE=2147483647
# Upload checks against the /authorize GUID: off | log (default) | enforce.
# See README "Upload sessions" before switching to enforce.
UPLOAD_SESSION_MODE=log
UPLOAD_SESSION_TTL_SECONDS=2592000
UPLOAD_MIN_PLAY_SECONDS=0
# 0 = off. Score may be at most this x seconds since /authorize.
MAX_SCORE_PER_SECOND=0
# Onboarding bridge (Pipedrive). ONBOARD_SHARED_SECRET unset = sign-ups are kept
# in onboarding_outbox and not sent. Retries for ONBOARD_RETRY_HOURS.
ONBOARD_URL=
ONBOARD_SHARED_SECRET=
ONBOARD_TIMEOUT_MS=5000
ONBOARD_RETRY_HOURS=24
ONBOARD_ALERT_AFTER_MINUTES=30
# Most new sign-ups per UTC day sent to Pipedrive; the rest are held and
# alerted on. 0 = no cap.
ONBOARD_DAILY_CAP=100
# Slack incoming webhook for #depot-alerts. Unset = alerts are only logged.
SLACK_WEBHOOK_URL=
# Support site notifications ("high_score_approved" on a new #1). Unset secret =
# nothing is sent. URL blank = https://support.thegoldstandard.com/api/notifications/events
NOTIFICATIONS_EVENT_SECRET=
SUPPORT_NOTIFY_URL=
# Boards (public keys) where a lower score is better. Blank = higher wins.
NOTIFY_ASCENDING_PUBLIC_KEYS=
# Observe mode: log-only security telemetry. Nothing is ever rejected. All of
# these are optional; "off" stops every observation write.
SECURITY_OBSERVE=on
# Comma-separated keys treated as expected. Blank = the shipped game's key.
OBSERVE_EXPECTED_PUBLIC_KEYS=
OBSERVE_MAX_SCORE=100000000
OBSERVE_MAX_USERNAME_LENGTH=60
# Proposed rate limits, "<requests>/<window seconds>". Recorded, not enforced.
OBSERVE_RATE_AUTHORIZE=30/600
OBSERVE_RATE_UPLOAD=20/600
OBSERVE_RATE_UPLOAD_GUID=5/600
OBSERVE_RATE_PROFILE=10/3600
# Write-volume caps: observation rows per reason, and issued GUID rows, per hour.
OBSERVE_MAX_ROWS_PER_HOUR=500
OBSERVE_MAX_ISSUED_PER_HOUR=2000
