PORT=8787
CORS_ORIGIN=*
DATABASE_URL=
SQLITE_PATH=./data/leaderboard.sqlite
ALLOWED_PUBLIC_KEYS=
ADMIN_TOKEN=change-this-to-a-long-random-secret
# Session login for the admin panel (used by the embedded hub).
ADMIN_PASSWORD=change-this-to-a-strong-password
SESSION_SECRET=change-this-to-a-long-random-secret
SESSION_TTL_SECONDS=43200
# "off" switches off the password login at /admin/login, so the hub's /sso is
# the only way in for a person. Default on. ADMIN_TOKEN header auth is unaffected.
DIRECT_ADMIN_LOGIN=on
# Hub single sign-on (short-lived HS256 JWT, aud "leaderboard").
LEADERBOARD_SSO_SECRET=change-this-to-a-long-random-secret
LEADERBOARD_SSO_AUDIENCE=leaderboard
# Origin allowed to embed the admin panel in an iframe.
HUB_ORIGIN=https://admin-panel-production-39e5.up.railway.app
# Optional. Key used to mask other players' GUIDs in GET /get. If blank, a key
# derived from SESSION_SECRET is used, else a random per-process value.
GUID_MASK_SECRET=
MAX_USERNAME_LENGTH=127
MAX_EXTRA_LENGTH=100
# Observe mode: log-only security telemetry. Nothing is ever rejected. All of
# these are optional; "off" stops every observation write.
SECURITY_OBSERVE=on
# Comma-separated keys treated as expected. Blank = the shipped game's key.
OBSERVE_EXPECTED_PUBLIC_KEYS=
OBSERVE_MAX_SCORE=100000000
OBSERVE_MAX_USERNAME_LENGTH=60
# Proposed rate limits, "<requests>/<window seconds>". Recorded, not enforced.
OBSERVE_RATE_AUTHORIZE=30/600
OBSERVE_RATE_UPLOAD=20/600
OBSERVE_RATE_UPLOAD_GUID=5/600
OBSERVE_RATE_PROFILE=10/3600
# Write-volume caps: observation rows per reason, and issued GUID rows, per hour.
OBSERVE_MAX_ROWS_PER_HOUR=500
OBSERVE_MAX_ISSUED_PER_HOUR=2000
